
{
  "entities": {
    "User": {
      "title": "User",
      "description": "Represents a user of the application with a specific role and permissions.",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "email": { "type": "string", "format": "email" },
        "displayName": { "type": "string" },
        "role": { "type": "string", "enum": ["super_admin", "admin", "supervisor", "tecnico_senior", "tecnico"] },
        "empresaId": { "type": "string" },
        "activo": { "type": "boolean" },
        "photoURL": { "type": "string", "format": "uri" }
      },
      "required": ["id", "email", "displayName", "role", "empresaId", "activo"]
    },
    "Empresa": {
      "title": "Empresa",
      "description": "Represents a company using the service.",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "razonSocial": { "type": "string" },
        "nombreComercial": { "type": "string" },
        "activa": { "type": "boolean" }
      },
      "required": ["id", "razonSocial", "activa"]
    },
    "Equipo": {
      "title": "Equipo",
      "description": "Represents a piece of equipment or a trap for pest control.",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "codigoInterno": { "type": "string" },
        "descripcion": { "type": "string" },
        "tipoEquipo": { "type": "string", "enum": ["tablero_electrico", "motor", "bomba", "ups", "transformador", "cebadera", "trampa", "otro"] },
        "estadoActual": { "type": "string", "enum": ["operativo", "fuera_de_servicio", "en_reparacion", "en_mantenimiento"] },
        "empresaId": { "type": "string" },
        "ubicacion": {
          "type": "object",
          "properties": {
            "planta": { "type": "string" },
            "sector": { "type": "string" }
          }
        }
      },
      "required": ["id", "codigoInterno", "descripcion", "tipoEquipo", "estadoActual", "empresaId"]
    },
    "Insumo": {
      "title": "Insumo",
      "description": "Catalog of chemicals or materials used in interventions.",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "internalCode": { "type": "string", "description": "Ej: M01, M02" },
        "type": { "type": "string", "enum": ["chemical", "material", "spare_part"] },
        "name": { "type": "string" },
        "activeIngredient": { "type": "string" },
        "registration": { "type": "string" },
        "toxicity": { "type": "string" },
        "msdsUrl": { "type": "string", "format": "uri" }
      },
      "required": ["id", "internalCode", "name", "type"]
    },
    "AuditLog": {
      "title": "AuditLog",
      "description": "Records every relevant action on an intervention.",
      "type": "object",
      "properties": {
        "timestamp": { "type": "string", "format": "date-time" },
        "userId": { "type": "string" },
        "userName": { "type": "string" },
        "action": { "type": "string" },
        "changes": { "type": "object" }
      }
    },
    "Intervencion": {
      "title": "Intervencion",
      "description": "Represents a maintenance or pest control intervention.",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "vertical": { "type": "string", "enum": ["maintenance", "pest_control"] },
        "locked": { "type": "boolean", "default": false },
        "token": { "type": "string", "description": "Security token for public access" },
        "closedAt": { "type": "string", "format": "date-time" },
        "numeroIntervencion": { "type": "string" },
        "equipoId": { "type": "string" },
        "tecnicoId": { "type": "string" },
        "tipoIntervencion": { "type": "string" },
        "estado": { "type": "string" },
        "trabajoRealizado": { "type": "string" },
        "empresaId": { "type": "string" }
      },
      "required": ["id", "vertical", "numeroIntervencion", "equipoId", "tecnicoId", "empresaId"]
    }
  },
  "auth": {
    "providers": ["email", "google"]
  },
  "firestore": {
    "/users/{userId}": {
      "schema": { "$ref": "#/entities/User" },
      "description": "Stores user profile information."
    },
    "/empresas/{empresaId}": {
      "schema": { "$ref": "#/entities/Empresa" },
      "description": "Stores company information."
    },
    "/equipos/{equipoId}": {
      "schema": { "$ref": "#/entities/Equipo" },
      "description": "Stores equipment/traps data."
    },
    "/insumos/{insumoId}": {
      "schema": { "$ref": "#/entities/Insumo" },
      "description": "Chemicals and materials catalog."
    },
    "/intervenciones/{intervencionId}": {
      "schema": { "$ref": "#/entities/Intervencion" },
      "description": "Stores records of interventions."
    },
    "/intervenciones/{intervencionId}/audit/{auditId}": {
      "schema": { "$ref": "#/entities/AuditLog" },
      "description": "Immutable history of changes."
    },
    "/intervenciones/{intervencionId}/evidence/{evidenceId}": {
      "schema": { "type": "object" },
      "description": "Photos and evidence files metadata."
    },
    "/intervenciones/{intervencionId}/signatures/{signatureId}": {
      "schema": { "type": "object" },
      "description": "Digital signatures for certification."
    },
    "/intervenciones/{intervencionId}/consumptions/{consumptionId}": {
      "schema": { "type": "object" },
      "description": "Detailed chemicals or parts consumption."
    }
  }
}
