
rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    
    // Helpers
    function isAuthenticated() {
      return request.auth != null;
    }
    
    function getUserData() {
      return get(/databases/$(database)/documents/users/$(request.auth.uid)).data;
    }
    
    function hasRole(role) {
      return isAuthenticated() && getUserData().role == role;
    }
    
    function belongsToSameEmpresa(empresaId) {
      return isAuthenticated() && getUserData().empresaId == empresaId;
    }

    function isNotLocked(resource) {
      return !('locked' in resource.data) || resource.data.locked == false;
    }

    // Colección de Usuarios
    match /users/{userId} {
      allow read: if isAuthenticated();
      allow write: if (request.auth.uid == userId) || hasRole('admin') || hasRole('super_admin');
    }

    // Colección de Empresas
    match /empresas/{empresaId} {
      allow read: if isAuthenticated() && (hasRole('admin') || hasRole('super_admin') || belongsToSameEmpresa(empresaId));
      allow write: if hasRole('admin') || hasRole('super_admin');
    }

    // Colección de Equipos
    match /equipos/{equipoId} {
      allow read: if isAuthenticated() && (hasRole('admin') || hasRole('super_admin') || belongsToSameEmpresa(resource.data.empresaId));
      allow write: if hasRole('admin') || hasRole('super_admin');
    }

    // Colección de Insumos
    match /insumos/{insumoId} {
      allow read: if isAuthenticated();
      allow write: if hasRole('admin') || hasRole('super_admin');
    }

    // Colección de Intervenciones
    match /intervenciones/{intervencionId} {
      // El acceso público ahora se valida verificando que el token enviado en el body/get coincida con el almacenado
      allow read: if (isAuthenticated() && (hasRole('admin') || hasRole('super_admin') || belongsToSameEmpresa(resource.data.empresaId))) || 
                     (request.auth == null && resource.data.token == request.resource.data.token);
      
      allow create: if isAuthenticated();
      
      allow update: if (
        // El cliente firma: solo puede actualizar signature, locked y closedAt si provee el token correcto
        (isNotLocked(resource) && request.resource.data.token == resource.data.token && 
         request.resource.data.diff(resource.data).affectedKeys().hasOnly(['signature', 'locked', 'closedAt', 'estado'])) ||
        
        // El staff opera
        (isAuthenticated() && (
          hasRole('admin') || hasRole('super_admin') ||
          (isNotLocked(resource) && (resource.data.tecnicoId == request.auth.uid))
        ))
      );

      allow delete: if hasRole('admin') || hasRole('super_admin');

      // Subcolección de Auditoría
      match /audit/{auditId} {
        allow read: if isAuthenticated() && (hasRole('admin') || hasRole('super_admin'));
        allow create: if isAuthenticated(); // Solo el sistema/usuarios autenticados registran logs
      }
    }
  }
}
