
rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    
    function isSignedIn() {
      return request.auth != null;
    }
    
    function userDoc() {
      return get(/databases/$(database)/documents/users/$(request.auth.uid)).data;
    }
    
    function hasRole(role) {
      return isSignedIn() && userDoc().role == role;
    }
    
    function inCompany(companyId) {
      return isSignedIn() && (userDoc().empresaId == companyId || hasRole('super_admin'));
    }

    function isNotLocked(id) {
      return !(get(/databases/$(database)/documents/intervenciones/$(id)).data.locked == true);
    }

    match /users/{userId} {
      allow read: if isSignedIn();
      allow write: if hasRole('admin') || hasRole('super_admin') || request.auth.uid == userId;
    }

    match /empresas/{empresaId} {
      allow read: if isSignedIn() && (hasRole('super_admin') || userDoc().empresaId == empresaId);
      allow write: if hasRole('super_admin');
    }

    match /equipos/{equipoId} {
      allow read: if isSignedIn() && inCompany(resource.data.empresaId);
      allow write: if isSignedIn() && (hasRole('admin') || hasRole('super_admin'));
    }

    match /insumos/{insumoId} {
      allow read: if isSignedIn();
      allow write: if hasRole('admin') || hasRole('super_admin');
    }

    match /intervenciones/{id} {
      // El acceso público se gestiona vía API Route / Servidor para validar tokens
      allow read: if isSignedIn() && inCompany(resource.data.empresaId);
      
      allow create: if isSignedIn() && inCompany(request.resource.data.empresaId);
      
      allow update: if isSignedIn() 
        && inCompany(resource.data.empresaId) 
        && isNotLocked(id);

      allow delete: if hasRole('super_admin');

      match /audit/{auditId} {
        allow read: if isSignedIn() && inCompany(get(/databases/$(database)/documents/intervenciones/$(id)).data.empresaId);
        allow create: if isSignedIn();
        allow update, delete: if false; 
      }
    }
  }
}
