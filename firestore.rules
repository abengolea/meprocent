
rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    
    function isAuthenticated() {
      return request.auth != null;
    }
    
    function getUserData() {
      return get(/databases/$(database)/documents/users/$(request.auth.uid)).data;
    }
    
    function hasRole(role) {
      return isAuthenticated() && getUserData().role == role;
    }
    
    function belongsToSameEmpresa(empresaId) {
      return isAuthenticated() && getUserData().empresaId == empresaId;
    }

    function isNotLocked(resource) {
      return !('locked' in resource.data) || resource.data.locked == false;
    }

    match /users/{userId} {
      allow read: if isAuthenticated();
      allow write: if hasRole('admin') || hasRole('super_admin');
    }

    match /empresas/{empresaId} {
      allow read: if isAuthenticated() && (hasRole('super_admin') || belongsToSameEmpresa(empresaId));
      allow write: if hasRole('admin') || hasRole('super_admin');
    }

    match /equipos/{equipoId} {
      allow read: if isAuthenticated() && belongsToSameEmpresa(resource.data.empresaId);
      allow write: if hasRole('admin') || hasRole('supervisor');
    }

    match /insumos/{insumoId} {
      allow read: if isAuthenticated();
      allow write: if hasRole('admin');
    }

    match /intervenciones/{intervencionId} {
      allow read: if isAuthenticated() && belongsToSameEmpresa(resource.data.empresaId);
      
      allow create: if isAuthenticated() && belongsToSameEmpresa(request.resource.data.empresaId);
      
      allow update: if isAuthenticated() && belongsToSameEmpresa(resource.data.empresaId) && (
        // Los admins pueden editar siempre o los técnicos si no está bloqueado
        hasRole('admin') || (isNotLocked(resource) && (resource.data.tecnicoId == request.auth.uid || hasRole('supervisor')))
      );

      allow delete: if hasRole('admin');
    }
  }
}
