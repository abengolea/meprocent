rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // --- FUNCIONES DE AYUDA ---
    function isSignedIn() {
      return request.auth != null;
    }
    
    function userDoc() {
      return get(/databases/$(database)/documents/users/$(request.auth.uid)).data;
    }
    
    function hasRole(role) {
      return isSignedIn() && userDoc().role == role;
    }
    
    function isSuperAdmin() {
      return hasRole('super_admin');
    }
    
    function inCompany(companyId) {
      return isSignedIn() && (userDoc().empresaId == companyId || isSuperAdmin());
    }

    function interventionDoc(id) {
      return get(/databases/$(database)/documents/intervenciones/$(id)).data;
    }

    function isNotLocked(id) {
      return !(interventionDoc(id).locked == true);
    }

    // --- REGLAS POR COLECCIÓN ---

    match /users/{userId} {
      // P0: Solo el propio usuario, super_admin o admin de la misma empresa pueden leer
      allow read: if isSignedIn() && (
        request.auth.uid == userId || 
        isSuperAdmin() || 
        (hasRole('admin') && userDoc().empresaId == resource.data.empresaId)
      );
      
      // P0: El usuario puede actualizar sus datos básicos pero NO su rol ni empresaId
      allow update: if isSignedIn() && request.auth.uid == userId 
        && request.resource.data.role == resource.data.role
        && request.resource.data.empresaId == resource.data.empresaId;
        
      allow create, update: if isSignedIn() && (hasRole('admin') || isSuperAdmin());
      allow delete: if false;
    }

    match /empresas/{empresaId} {
      allow read: if isSignedIn() && (isSuperAdmin() || userDoc().empresaId == empresaId);
      allow write: if isSuperAdmin();
    }

    match /equipos/{equipoId} {
      allow read: if isSignedIn() && inCompany(resource.data.empresaId);
      allow write: if isSignedIn() && (hasRole('admin') || isSuperAdmin());
      allow delete: if false;
    }

    match /insumos/{insumoId} {
      allow read: if isSignedIn() && (isSuperAdmin() || inCompany(resource.data.empresaId));
      allow write: if hasRole('admin') || isSuperAdmin();
    }

    match /intervenciones/{id} {
      // Permitir GET público para el portal de firma (la seguridad reside en el ID y el token)
      allow get: if true;
      
      allow list: if isSignedIn() && inCompany(resource.data.empresaId);
      
      allow create: if isSignedIn() && inCompany(request.resource.data.empresaId);
      
      // Bloquear actualización si el documento está locked
      allow update: if (isSignedIn() && inCompany(resource.data.empresaId) && isNotLocked(id))
                    || (request.resource.data.diff(resource.data).affectedKeys().hasOnly(['signature', 'locked', 'estado', 'closedAt']));

      allow delete: if false;

      // Subcolecciones protegidas por empresa e inmutabilidad
      match /audit/{auditId} {
        allow read: if isSignedIn() && inCompany(interventionDoc(id).empresaId);
        allow create: if (isSignedIn() && inCompany(interventionDoc(id).empresaId)) || true;
        allow update, delete: if false; 
      }

      match /evidence/{evId} {
        allow read: if isSignedIn() && inCompany(interventionDoc(id).empresaId);
        allow create: if isSignedIn() && inCompany(interventionDoc(id).empresaId) && isNotLocked(id);
        allow update, delete: if false;
      }

      match /signatures/{sigId} {
        allow read: if isSignedIn() && inCompany(interventionDoc(id).empresaId);
        allow create: if isNotLocked(id);
        allow update, delete: if false;
      }

      match /consumptions/{cId} {
        allow read: if isSignedIn() && inCompany(interventionDoc(id).empresaId);
        allow create: if isSignedIn() && inCompany(interventionDoc(id).empresaId) && isNotLocked(id);
        allow update, delete: if false;
      }
    }
  }
}