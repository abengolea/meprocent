
rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    
    function isAuthenticated() {
      return request.auth != null;
    }
    
    function getUserData() {
      return get(/databases/$(database)/documents/users/$(request.auth.uid)).data;
    }
    
    function hasRole(role) {
      return isAuthenticated() && getUserData().role == role;
    }
    
    function belongsToSameEmpresa(empresaId) {
      return isAuthenticated() && getUserData().empresaId == empresaId;
    }

    function isNotLocked(resource) {
      return !('locked' in resource.data) || resource.data.locked == false;
    }

    match /users/{userId} {
      allow read: if isAuthenticated();
      allow write: if hasRole('admin') || hasRole('super_admin');
    }

    match /empresas/{empresaId} {
      allow read: if isAuthenticated() && (hasRole('super_admin') || belongsToSameEmpresa(empresaId));
      allow write: if hasRole('admin') || hasRole('super_admin');
    }

    match /equipos/{equipoId} {
      allow read: if isAuthenticated() && belongsToSameEmpresa(resource.data.empresaId);
      allow write: if hasRole('admin') || hasRole('supervisor');
    }

    match /insumos/{insumoId} {
      allow read: if isAuthenticated();
      allow write: if hasRole('admin');
    }

    match /intervenciones/{intervencionId} {
      // Allow public access via token for clients
      allow read: if (isAuthenticated() && belongsToSameEmpresa(resource.data.empresaId)) || 
                     (request.query.token == resource.data.token);
      
      allow create: if isAuthenticated() && belongsToSameEmpresa(request.resource.data.empresaId);
      
      allow update: if (
        // Permiso para el cliente de firmar (solo puede actualizar signature y locked)
        (request.query.token == resource.data.token && 
         request.resource.data.diff(resource.data).affectedKeys().hasOnly(['signature', 'locked', 'closedAt'])) ||
        
        // Permiso para el staff
        (isAuthenticated() && belongsToSameEmpresa(resource.data.empresaId) && (
          // Admins pueden editar siempre (para correcciones post-bloqueo si es necesario)
          hasRole('admin') || 
          // Técnicos solo si no está bloqueado
          (isNotLocked(resource) && (resource.data.tecnicoId == request.auth.uid || hasRole('supervisor')))
        ))
      );

      allow delete: if hasRole('admin');
    }
  }
}
