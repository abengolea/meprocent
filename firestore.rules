
rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    
    // Helpers
    function isAuthenticated() {
      return request.auth != null;
    }
    
    function getUserData() {
      return get(/databases/$(database)/documents/users/$(request.auth.uid)).data;
    }
    
    function hasRole(role) {
      return isAuthenticated() && getUserData().role == role;
    }
    
    function belongsToSameEmpresa(empresaId) {
      return isAuthenticated() && getUserData().empresaId == empresaId;
    }

    function isNotLocked(resource) {
      return !('locked' in resource.data) || resource.data.locked == false;
    }

    // Colección de Usuarios
    match /users/{userId} {
      allow read: if isAuthenticated();
      // Solo el usuario puede actualizar su foto/nombre, admins gestionan roles
      allow write: if (request.auth.uid == userId) || hasRole('admin');
    }

    // Colección de Empresas
    match /empresas/{empresaId} {
      allow read: if isAuthenticated() && (hasRole('admin') || belongsToSameEmpresa(empresaId));
      allow write: if hasRole('admin');
    }

    // Colección de Equipos
    match /equipos/{equipoId} {
      allow read: if isAuthenticated() && (hasRole('admin') || belongsToSameEmpresa(resource.data.empresaId));
      allow write: if hasRole('admin');
    }

    // Colección de Insumos/Químicos
    match /insumos/{insumoId} {
      allow read: if isAuthenticated();
      allow write: if hasRole('admin');
    }

    // Colección de Intervenciones (Expedientes)
    match /intervenciones/{intervencionId} {
      // Acceso público vía token para clientes o acceso por empresa para staff
      allow read: if (isAuthenticated() && (hasRole('admin') || belongsToSameEmpresa(resource.data.empresaId))) || 
                     (request.query.token == resource.data.token);
      
      allow create: if isAuthenticated();
      
      allow update: if (
        // Permiso para el cliente de firmar (solo puede actualizar signature, locked y closedAt)
        (request.query.token == resource.data.token && 
         request.resource.data.diff(resource.data).affectedKeys().hasOnly(['signature', 'locked', 'closedAt'])) ||
        
        // Permiso para el staff
        (isAuthenticated() && (
          hasRole('admin') || 
          (isNotLocked(resource) && (resource.data.tecnicoId == request.auth.uid))
        ))
      );

      allow delete: if hasRole('admin');
    }
  }
}
